{
  "extends": "@da/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node", "@testing-library/jest-dom/vitest"],
    "paths": { "@/*": ["./src/*"] },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
