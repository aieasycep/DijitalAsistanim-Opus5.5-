    "@react-native-google-signin/google-signin": "catalog:expo",
    "@sentry/react-native": "catalog:expo",
    "@shopify/flash-list": "catalog:expo",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/query-async-storage-persister": "catalog:expo",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:expo",
    "expo": "catalog:expo",
    "expo-apple-authentication": "catalog:expo",
    "expo-application": "catalog:expo",
    "expo-audio": "catalog:expo",
    "expo-background-task": "catalog:expo",
