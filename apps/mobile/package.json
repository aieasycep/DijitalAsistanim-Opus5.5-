{
  "name": "@da/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "export": "expo export --platform ios --platform android --output-dir .expo-export",
    "prebuild:smoke": "bash ../../scripts/mobile/prebuild-smoke.sh",
    "mobile:check": "EXPO_OFFLINE=1 expo install --check && expo export --platform ios --platform android --output-dir .expo-export && bash ../../scripts/mobile/prebuild-smoke.sh",
    "assets": "node ../../scripts/mobile/render-assets.ts",
    "widgets:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-widget-native.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "licenses": "node scripts/generate-licenses.mjs"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@bacons/apple-targets": "catalog:expo",
    "@da/api-client": "workspace:*",
    "@da/design-tokens": "workspace:*",
    "@da/domain": "workspace:*",
    "@da/i18n": "workspace:*",
    "@da/ui": "workspace:*",
    "@da/validation": "workspace:*",
