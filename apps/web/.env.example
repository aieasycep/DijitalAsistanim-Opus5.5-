# apps/web environment — KEY NAMES ONLY. Never commit real values (.env* is git-ignored).
# Validated by src/env/schema.ts at build time (next.config.ts) and on every server read.
# The web holds no secret: every value below is a public identifier or a display value.
# Tags: client-safe = inlined into the browser bundle; server = read on the server only.

# ── Deployment ────────────────────────────────────────────────────────────
# server — development | test | preview | staging | production (default development)
APP_ENV=development
# server — set by Vercel; a preview deployment is never indexable
VERCEL_ENV=
# server — "true" only for the launched production site (robots, sitemap, meta robots)
SITE_INDEXABLE=false

# ── URLs ──────────────────────────────────────────────────────────────────
# client-safe — canonical origin, no trailing slash (default https://dijitalasistan.app)
NEXT_PUBLIC_SITE_URL=
# client-safe — Supabase project URL; the browser calls <url>/functions/v1/public-api
NEXT_PUBLIC_SUPABASE_URL=
# client-safe — publishable key (sb_publishable_…); a secret key is rejected
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server — base URL for server-side public-api reads (plans, referral lookup)
API_PUBLIC_BASE_URL=
# client-safe — privacy-safe first-party page analytics (public-api /web-events)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# client-safe — Cloudflare Turnstile on the support and deletion forms (optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Stores and app links (External credential required) ───────────────────
# server — Apple Developer Team ID (10 characters); without it the AASA file is a 404
APPLE_TEAM_ID=
# server — default com.dijitalasistan.app
IOS_BUNDLE_IDENTIFIER=com.dijitalasistan.app
# server — default com.dijitalasistan.app
ANDROID_PACKAGE=com.dijitalasistan.app
# server — Play app signing SHA-256 fingerprints, comma-separated AA:BB:… ; without them assetlinks.json is a 404
ANDROID_SHA256_CERT_FINGERPRINTS=
# server — numeric App Store ID; without it the App Store buttons are hidden
IOS_APP_STORE_ID=
# server — App Store Connect campaign provider token (pt=)
APP_STORE_PROVIDER_TOKEN=
# server — Microsoft Entra application (client) ID for microsoft-identity-association.json and admin consent
MICROSOFT_CLIENT_ID=

# ── Legal pages (Manual external step: values from the company records) ───
# server — registered legal name, address, MERSIS number and KEP address of the data controller
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_MERSIS_NO=
COMPANY_KEP_ADDRESS=
# server — default gizlilik@dijitalasistan.app
PRIVACY_CONTACT_EMAIL=
# server — GDPR Art. 27 representative, when appointed
EU_REPRESENTATIVE=
# server — Supabase region shown on the privacy page (eu-central-1 is shown as Frankfurt)
DATA_REGION_LABEL=
# server — Sentry data region label for the sub-processor table
SENTRY_REGION_LABEL=
# server — database backup retention in days (1–365) for the retention table
BACKUP_RETENTION_DAYS=
# server — transactional email provider named in the sub-processor table: resend | postmark | ses | smtp
EMAIL_PROVIDER=
