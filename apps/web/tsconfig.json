{
  "extends": "@da/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/dev"]
}
